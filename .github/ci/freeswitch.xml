<?xml version="1.0"?>
<!--
  Minimal FreeSWITCH configuration used ONLY by CI.

  Purpose: boot the FreeSWITCH core with no telephony (no sofia, no codecs
  beyond the core set, no sound files) so we can prove that mod_ws_media
  actually dlopen()s into a real FreeSWITCH and registers its interfaces.
  A compile check cannot catch an unresolved symbol at load time; this can.

  ws_media.conf.xml is pulled in from autoload_configs so the module's own
  config parsing is exercised too.
-->
<document type="freeswitch/xml">
  <section name="configuration" description="CI">

    <configuration name="switch.conf" description="Core">
      <settings>
        <param name="max-sessions" value="20"/>
        <param name="sessions-per-second" value="10"/>
        <param name="rtp-start-port" value="26000"/>
        <param name="rtp-end-port" value="26100"/>
      </settings>
    </configuration>

    <configuration name="modules.conf" description="Modules">
      <modules>
        <load module="mod_console"/>
        <load module="mod_commands"/>
        <load module="mod_dptools"/>
        <load module="mod_event_socket"/>
        <!-- the module under test -->
        <load module="mod_ws_media"/>
      </modules>
    </configuration>

    <configuration name="console.conf" description="Console">
      <mappings>
        <map name="all" value="console,debug,info,notice,warning,err,crit,alert"/>
      </mappings>
      <settings>
        <param name="colorize" value="false"/>
        <param name="loglevel" value="info"/>
      </settings>
    </configuration>

    <configuration name="event_socket.conf" description="Socket Client">
      <settings>
        <param name="listen-ip" value="127.0.0.1"/>
        <param name="listen-port" value="8021"/>
        <param name="password" value="ClueCon"/>
      </settings>
    </configuration>

    <X-PRE-PROCESS cmd="include" data="autoload_configs/ws_media.conf.xml"/>

  </section>
</document>
